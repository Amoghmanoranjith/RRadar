# Include any custom binaries you build (e.g., if you output to a bin/ directory)
/bin/

# Compiled Object files, Object directories, Shared libraries
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binaries and artifacts
*.test
*.out
*.coverprofile
profile.cov

# Dependency directories
